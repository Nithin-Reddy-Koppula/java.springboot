<?xml version="1.0" encoding="UTF-8"?>

<!--
    Maven configuration file for the Day 10 Book API.

    Maven uses this file to:
    - manage dependencies
    - compile Java code
    - run tests
    - create the executable JAR
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven project model version -->
    <modelVersion>4.0.0</modelVersion>


    <!-- Spring Boot parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>


    <!-- Project information -->
    <groupId>com.example</groupId>
    <artifactId>day-10-book-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>Day 10 Book API</name>

    <description>
        Spring Boot Book API - Day 10 Testing Documentation and Packaging
    </description>


    <!-- Project properties -->
    <properties>

        <!-- Java version -->
        <java.version>17</java.version>

        <!--
            IMPORTANT:
            Your project contains multiple Spring Boot applications:

            Day_6.Day6Application
            Day_7.BookApiApplication
            Day_8.Day8Application
            Day_9.Day9Application
            Day_10.Day10Application

            This tells Maven which one should be used
            as the main class when creating the executable JAR.
        -->
        <start-class>Day_10.Day10Application</start-class>

    </properties>


    <!-- ====================================================== -->
    <!-- DEPENDENCIES                                           -->
    <!-- ====================================================== -->

    <dependencies>


        <!--
            Spring Web

            Provides REST API functionality.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!--
            Spring Data JPA

            Provides:
            - JpaRepository
            - Hibernate
            - JPA database operations
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>


        <!--
            MySQL database driver.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!--
            Spring Boot testing framework.

            Includes:
            - JUnit 5
            - Mockito
            - Spring Test
            - MockMvc
            - AssertJ
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!--
            Springdoc OpenAPI.

            Provides Swagger UI and OpenAPI documentation.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>


    </dependencies>


    <!-- ====================================================== -->
    <!-- BUILD CONFIGURATION                                    -->
    <!-- ====================================================== -->

    <build>

        <plugins>

            <!--
                Spring Boot Maven Plugin.

                Used to:
                - create executable JAR
                - run Spring Boot application
                - package dependencies
            -->
            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>

        </plugins>

    </build>


</project>